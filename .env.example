# 网关自身的鉴权 key（Authorization: Bearer 或 x-api-key 均可；留空则不鉴权）
API_KEY=
# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=corvex2api
# 上游
UPSTREAM_BASE=https://api.tokenfactory.corvex.cloud
# 上游出口代理（http://user:pass@host:port），留空直连
PROXY=
# 转发超时（秒，读超时同样作用于流式间隔）
TIMEOUT_SECONDS=180
# 单次请求最多尝试的账号数
MAX_ACCOUNT_RETRIES=3
# 429 冷却秒数（上游 Retry-After 优先）
RATE_LIMIT_COOLDOWN=60
# /v1/models 缓存秒数
MODELS_CACHE_SECONDS=3600
